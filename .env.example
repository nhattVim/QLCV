# ==========================================
# CẤU HÌNH KẾT NỐI MONGODB ATLAS
# ==========================================
MONGODB_URI=mongodb+srv://admin:password@cluster0.xxxxx.mongodb.net/?retryWrites=true&w=majority
DB_NAME=qlcv_db
DEFAULT_ADMIN_EMAIL=admin@qlcv.com
DEFAULT_ADMIN_PASSWORD=admin123
DEFAULT_ADMIN_NAME=Quản Trị Viên

# ==========================================
# CẤU HÌNH CLOUDFLARE R2 (S3-COMPATIBLE STORAGE)
# ==========================================
S3_ENDPOINT=https://<YOUR_CLOUDFLARE_ACCOUNT_ID>.r2.cloudflarestorage.com
S3_ACCESS_KEY_ID=<YOUR_R2_ACCESS_KEY_ID>
S3_SECRET_ACCESS_KEY=<YOUR_R2_SECRET_ACCESS_KEY>
S3_BUCKET=qlcv-attachments
S3_REGION=auto